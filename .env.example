# .env file for docker-compose (.env)
# Do not use this file as is in production!

# Application Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SECRET_KEY=change-this-secret-key-in-production

# Database settings
POSTGRES_USER=liberoo_user
POSTGRES_PASSWORD=liberoo_password
POSTGRES_DB=liberoo_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# For local development (when running outside Docker)
# POSTGRES_HOST=localhost

# Optional: Additional configuration
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
