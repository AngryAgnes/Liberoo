# .env file for FastAPI app (app/.env)
# Do not use this file as is in production!

# FastAPI app settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
SECRET_KEY=your-secret-key

# Database settings
POSTGRES_USER=liberoo_user
POSTGRES_PASSWORD=liberoo_password
POSTGRES_DB=liberoo_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
